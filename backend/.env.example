# =============================================================================
# Noctra AI — Backend Environment Variables
# Copy this file to `.env` and fill in your three API keys.
# NEVER commit the real .env to git.
# =============================================================================

# --- AI scoring & explanation (Google AI Studio) ---
# Get yours: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- IP reputation lookup ---
# Get yours: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# --- IP / hash / domain enrichment ---
# Get yours: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# --- Runtime settings (safe defaults — change only if you know why) ---
SESSION_TTL_MINUTES=30
SESSION_SWEEP_INTERVAL_SECONDS=60
MAX_UPLOAD_MB=25
CORS_ORIGIN=http://localhost:5173
