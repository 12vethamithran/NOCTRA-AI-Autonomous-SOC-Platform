# Copy to .env.prod and fill in values before running docker-compose.prod.yml
# docker-compose --env-file .env.prod -f docker-compose.prod.yml up -d

GEMINI_API_KEY=
ABUSEIPDB_API_KEY=
VIRUSTOTAL_API_KEY=

# URL where your frontend is hosted (used for backend CORS)
FRONTEND_URL=http://localhost:3000

# URL where your backend is hosted (baked into frontend build)
BACKEND_URL=http://localhost:8000

SESSION_TTL_MINUTES=30
MAX_UPLOAD_MB=25
